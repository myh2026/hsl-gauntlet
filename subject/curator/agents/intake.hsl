// ============================================================================
// curator/agents/intake.hsl — 批次入口：fixture batch 轨道加载 + 文档解析 + 拉取
// ============================================================================
// 文法覆盖：while + 哨兵 / for-in 计数游标 / early return / Result 通道 /
//           HashMap 工具 / unwrap_or 默认值
// ============================================================================

import { Doc, DocEvent } from "../types/docs.hsl";
import { HarnessError } from "../types/errors.hsl";

/// 批次入口节点：加载并解析全部文档（fixture batch 轨道 = 环境脚本）。
#[derive(Debug, Clone)]
export struct DocumentLog {
    docs: Vec<Doc>,
}

impl DocumentLog {
    fn new(lines: Vec<String>) -> Result<DocumentLog, HarnessError> {
        let mut docs: Vec<Doc> = Vec::new();
        for line in lines {
            docs.push(parse_doc_line(line)?);
        }
        Ok(DocumentLog { docs })
    }

    /// 拉取第 idx 条文档（0 基游标，游标推进在 graph 体内经 bump! 完成）。
    fn poll(self, idx: u32) -> DocEvent {
        let mut i: u32 = 0;
        for d in self.docs.clone() {
            if i == idx {
                return DocEvent::DocumentReceived { doc: d };
            }
            i += 1;
        }
        DocEvent::BatchEmpty
    }
}

/// 从 fixture batch 轨道逐条加载原始文档行（空串 = 轨道耗尽哨兵）。
export fn load_batch() -> Vec<String> {
    let mut lines: Vec<String> = Vec::new();
    let mut more: bool = true;
    while more {
        let line: String = native typescript {
            try {
                return await $host.fixture.next("batch");
            } catch (e) {
                return "";
            }
        };
        if line.len() == 0 {
            more = false;
        } else {
            lines.push(line);
        }
    }
    lines
}

fn parse_doc_line(line: String) -> Result<Doc, HarnessError> {
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(line);
        } catch (e) {
            const m = new Map();
            m.set("error", String(e && e.message || e));
            return m;
        }
    };
    if fields.contains_key("error") {
        let detail = fields.get("error").unwrap_or(String::from("?"));
        return Err(HarnessError::new(String::from("batch"), format!("文档行不是合法 JSON：{}", detail)));
    }
    Ok(Doc {
        id: fields.get("id").unwrap_or(String::from("unknown-id")),
        source: fields.get("source").unwrap_or(String::from("unknown")),
        title: fields.get("title").unwrap_or(String::from("(untitled)")),
        body: fields.get("body").unwrap_or(String::from("")),
    })
}
