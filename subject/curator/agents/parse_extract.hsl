// ============================================================================
// curator/agents/parse_extract.hsl — 抽取协议解析（严格 JSON 协议 + 软硬漂移）
// ============================================================================
// 硬漂移（非法 JSON）→ Err；软漂移（合法 JSON 但缺 entities 数组）→ Malformed。
// 二者都由 graph 侧归类进 Malformed 漂移通道（extractor 自环边）。
//
// #L-22 修复后的直构通道版（v1.2 起）：native 体内用 $host.make 直接构造
// 带运行时 __struct/__enum 标记的合法 HSL 值（Entity / ExtractEvent /
// Result / HarnessError 全族嵌套构造）—— 此前（值模型断层期，#L-22）native
// 返回的 plain object 是 foreign 值（字段直通可用，clone/方法/模式派发
// 全失效），唯一出路是「JSON → 拍平字符串 kind~value~conf|…」+ HSL 侧
// split_once 逐字段重建（~40 行协议代码 + 协议保留字约束：entity value
// 不得含 "~" 与 "|"）。本版本删除全部拍平协议与重建定式。
//
// 文法覆盖：$host.make 结构体/嵌套枚举变体/元组变体 / match 派发
// ============================================================================

import { Entity } from "../types/docs.hsl";
import { ExtractEvent } from "../types/vocab.hsl";
import { HarnessError } from "../types/errors.hsl";

/// 模型输出 → Result<ExtractEvent, HarnessError>。
/// 协议：恰好一个 JSON 对象，形如 {"entities": [{"kind": .., "value": .., "confidence": ..}]}。
export fn parse_extract(raw: String) -> Result<ExtractEvent, HarnessError> {
    let parsed: Result<ExtractEvent, HarnessError> = native typescript {
        let parsed;
        try {
            parsed = $host.json.parse(raw);
        } catch (e) {
            return $host.make("Result::Err", [
                $host.make("HarnessError", {
                    kind: "protocol",
                    message: "抽取输出不是合法 JSON：" + String(e && e.message || e),
                }),
            ]);
        }
        if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed) || !Array.isArray(parsed.entities)) {
            return $host.make("Result::Ok", [
                $host.make("ExtractEvent::Malformed", { note: "抽取输出缺少 entities 数组（软漂移）" }),
            ]);
        }
        const entities = parsed.entities.map((e) =>
            $host.make("Entity", {
                kind: String(e.kind ?? ""),
                value: String(e.value ?? ""),
                confidence: e.confidence,
            }),
        );
        return $host.make("Result::Ok", [
            $host.make("ExtractEvent::EntitiesExtracted", { entities }),
        ]);
    };
    return parsed;
}
