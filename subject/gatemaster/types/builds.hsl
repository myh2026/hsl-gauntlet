// ============================================================================
// gatemaster/types/builds.hsl — 数据面：构建 / 案例记录 / 消息 / 批次与账本事件
// ============================================================================
// 文法覆盖：struct 派生 / Vec 泛型字段 / enum 结构变体 + 单元变体 /
//           impl 构造器族 / for-in 渲染
// ============================================================================

/// 待分诊的失败构建（batch 轨道逐条加载；log 字段可被截断 → 触发重取回环）。
#[derive(Debug, Clone)]
export struct Build {
    id: String,
    repo: String,
    commit: String,
    log: String,
}

/// 处置案例记录（产物 cases.jsonl 的数据面）。
#[derive(Debug, Clone)]
export struct CaseRecord {
    build_id: String,
    disposition: String,   // fixed / escalated / abandoned
    detail: String,
}

/// 会话消息（transcript 产物 + 模型端口输入）。
#[derive(Debug, Clone)]
export struct Message {
    role: String,
    content: String,
}

impl Message {
    fn system(content: String) -> Message {
        Message { role: String::from("system"), content }
    }
    fn user(content: String) -> Message {
        Message { role: String::from("user"), content }
    }
    fn assistant(content: String) -> Message {
        Message { role: String::from("assistant"), content }
    }
    fn tool(content: String) -> Message {
        Message { role: String::from("tool"), content }
    }
}

impl Build {
    /// 渲染为分类 prompt 的用户面（N1 纪律：组装在 HSL 侧）。
    fn render(self) -> String {
        let mut out = String::from("build ");
        out.push_str(self.id.as_str());
        out.push_str(" | ");
        out.push_str(self.repo.as_str());
        out.push_str(" @ ");
        out.push_str(self.commit.as_str());
        out.push_str("\n--- log ---\n");
        out.push_str(self.log.as_str());
        out
    }
}

/// 批次事件（intake 节点输出）—— 1 条边：
///   intake -> log_gate on BuildReceived
/// BatchEmpty 不挂边（无转移语义）。
#[derive(Debug, Clone)]
export enum BuildEvent {
    BuildReceived { build: Build },
    BatchEmpty,
}

/// 账本事件（ledger 节点输出）—— 1 条边：
///   ledger -> intake on CaseDispatched（批次推进 = 案例落账）
#[derive(Debug, Clone)]
export enum LedgerEvent {
    CaseDispatched { receipt: String },
}
