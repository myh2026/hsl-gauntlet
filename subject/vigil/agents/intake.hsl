// ============================================================================
// vigil/agents/intake.hsl — 收件箱：fixture inbox 轨道加载 + 告警解析 + 拉取
// ============================================================================
// 文法覆盖：while + 哨兵 / for-in 计数游标 / early return / Result 通道 /
//           HashMap 工具 / unwrap_or 默认值
// ============================================================================

import { Alert, IntakeEvent } from "../types/alerts.hsl";
import { HarnessError } from "../types/errors.hsl";

/// 收件箱节点：加载并解析全部告警（fixture inbox 轨道 = 环境脚本）。
#[derive(Debug, Clone)]
export struct AlertLog {
    alerts: Vec<Alert>,
}

impl AlertLog {
    fn new(lines: Vec<String>) -> Result<AlertLog, HarnessError> {
        let mut alerts: Vec<Alert> = Vec::new();
        for line in lines {
            alerts.push(parse_alert_line(line)?);
        }
        Ok(AlertLog { alerts })
    }

    /// 拉取第 idx 条告警（0 基游标，游标推进在 graph 体内经 bump! 完成）。
    fn poll(self, idx: u32) -> IntakeEvent {
        let mut i: u32 = 0;
        for a in self.alerts.clone() {
            if i == idx {
                return IntakeEvent::AlertReceived { alert: a };
            }
            i += 1;
        }
        IntakeEvent::InboxEmpty
    }
}

/// 从 fixture inbox 轨道逐条加载原始告警行（空串 = 轨道耗尽哨兵）。
export fn load_inbox() -> Vec<String> {
    let mut lines: Vec<String> = Vec::new();
    let mut more: bool = true;
    while more {
        let line: String = native typescript {
            try {
                return await $host.fixture.next("inbox");
            } catch (e) {
                return "";
            }
        };
        if line.len() == 0 {
            more = false;
        } else {
            lines.push(line);
        }
    }
    lines
}

fn parse_alert_line(line: String) -> Result<Alert, HarnessError> {
    let fields: HashMap<String, String> = native typescript {
        try {
            return $host.json.fields(line);
        } catch (e) {
            const m = new Map();
            m.set("error", String(e && e.message || e));
            return m;
        }
    };
    if fields.contains_key("error") {
        let detail = fields.get("error").unwrap_or(String::from("?"));
        return Err(HarnessError::new(String::from("inbox"), format!("告警行不是合法 JSON：{}", detail)));
    }
    Ok(Alert {
        id: fields.get("id").unwrap_or(String::from("unknown-id")),
        source: fields.get("source").unwrap_or(String::from("unknown")),
        severity: fields.get("severity").unwrap_or(String::from("warning")),
        title: fields.get("title").unwrap_or(String::from("(untitled)")),
        body: fields.get("body").unwrap_or(String::from("")),
    })
}
