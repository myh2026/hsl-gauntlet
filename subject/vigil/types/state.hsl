// ============================================================================
// vigil/types/state.hsl — 策略 / 预算 / 会话统计 / 会话状态 / 运行报告
// ============================================================================
// 文法覆盖：const（进制/下划线字面量）/ turbofish parse::<T>() /
//           HashMap<String,String> / Option 链 / Vec<String> 方法链
// ============================================================================

import { Message, CaseRecord } from "./alerts.hsl";
import { BudgetSignal } from "./vocab.hsl";
import { HarnessError } from "./errors.hsl";

export const DEFAULT_MAX_TURNS: u32 = 0x08;      // 8 —— 会话总轮预算（十六进制字面量）
export const DEFAULT_MAX_DRIFT: u32 = 2;          // 分诊协议漂移上限
export const DEFAULT_MAX_PROBE: u32 = 2;          // 单告警探查重试上限（共 3 次探查）
export const DEFAULT_MAX_ROUNDS: u32 = 4_000 / 2_000; // 审稿返工上限（下划线字面量 + 算术）

/// 运行策略（CLI --flags 装配，经 $host.config 读取）。
#[derive(Debug, Clone)]
export struct Policy {
    model: String,           // scripted | live
    temperature: f64,
    max_turns: u32,
    max_drift: u32,
    max_probe: u32,
    max_rounds: u32,
    workspace: String,
    task: String,
}

impl Policy {
    fn from_config() -> Result<Policy, HarnessError> {
        let cfg: HashMap<String, String> = native typescript {
            const c = $host.config;
            const m = new Map();
            m.set("model", String(c.model));
            m.set("temperature", String(c.temperature));
            m.set("max_turns", String(c.maxTurns));
            m.set("workspace", String(c.workspace));
            m.set("task", String(c.task));
            return m;
        };
        let model = cfg.get("model").unwrap_or(String::from("scripted"));
        let temperature = cfg.get("temperature").unwrap_or(String::from("0.2")).parse::<f64>()?;
        let max_turns = cfg.get("max_turns").unwrap_or(String::from("24")).parse::<u32>()?;
        let workspace = cfg.get("workspace").unwrap_or(String::from("."));
        let task = cfg.get("task").unwrap_or(String::from(""));
        Ok(Policy {
            model,
            temperature,
            max_turns,
            max_drift: DEFAULT_MAX_DRIFT,
            max_probe: DEFAULT_MAX_PROBE,
            max_rounds: DEFAULT_MAX_ROUNDS,
            workspace,
            task,
        })
    }
}

/// 会话预算（在 graph 体内经 bump! 宏原地推进）。
#[derive(Debug, Clone)]
export struct Budget {
    turns_used: u32,
    drift_count: u32,
}

impl Budget {
    fn zero() -> Budget {
        Budget { turns_used: 0, drift_count: 0 }
    }

    fn status(self, policy: Policy) -> BudgetSignal {
        if self.turns_used >= policy.max_turns {
            BudgetSignal::Exhausted
        } else if self.drift_count >= policy.max_drift {
            BudgetSignal::DriftWarn
        } else {
            BudgetSignal::Within
        }
    }
}

/// 会话统计（产物 report.md 的数据面）。
#[derive(Debug, Clone)]
export struct SessionStats {
    alerts_seen: u32,
    committed: u32,
    parked: u32,
    escalated: u32,
    drift_retries: u32,
    probe_failures: u32,
    rejections: u32,
    insufficient: u32,
}

impl SessionStats {
    fn zero() -> SessionStats {
        SessionStats {
            alerts_seen: 0,
            committed: 0,
            parked: 0,
            escalated: 0,
            drift_retries: 0,
            probe_failures: 0,
            rejections: 0,
            insufficient: 0,
        }
    }
}

/// 会话状态（graph 主参数；mut 参数 + 字段级原地推进）。
/// 预算不在此层：budget 是 graph 体内的 mut 节点（本地可变顶点状态）。
#[derive(Debug, Clone)]
export struct SessionState {
    policy: Policy,
    transcript: Vec<Message>,
    stats: SessionStats,
    inbox: Vec<String>,      // 告警原始行（fixture inbox 轨道加载）
    inbox_idx: u32,          // 已拉取游标
    drift_noted: bool,       // DriftWarn 提醒只注入一次
}

/// 运行报告（harness 出口产物）。
#[derive(Debug, Clone)]
export struct RunReport {
    task: String,
    verdict: String,         // inbox-drained / budget-exhausted
    cases: Vec<CaseRecord>,
    stats: SessionStats,
    transcript: Vec<Message>,
    ok: bool,
}
