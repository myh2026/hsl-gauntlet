// ============================================================================
// vigil/config/resources.hsl — 静态资源层（block / static + {{}} 编译期插值）
// ============================================================================
// 文法覆盖：block+static 两种资源形态 / 模式 A 词法（JSON 大括号深度计数）/
//           {{ expr }} 插值（N4/N5）
// ============================================================================

import { DEFAULT_MAX_TURNS, DEFAULT_MAX_DRIFT, DEFAULT_MAX_PROBE, DEFAULT_MAX_ROUNDS } from "../types/state.hsl";

/// 分诊系统提示词（真实注入 LLM 的完整协议说明）。
export block TRIAGE_PROMPT {
You are Vigil, an SRE alert triage agent. For each alert, decide how to proceed.

# Protocol (CRITICAL)
Every turn you respond with EXACTLY ONE JSON object. No prose. No markdown fences.
The "decision" field MUST be one of:
- {"decision": "investigate", "hypothesis": "<one-sentence causal hypothesis>"}
- {"decision": "escalate", "reason": "<why this needs a human right now>"}

# Rules
1. critical severity with unclear cause usually merits escalate.
2. investigate when telemetry and runbook can plausibly confirm a hypothesis.
3. Budget: at most {{DEFAULT_MAX_DRIFT}} protocol violations before forced parking.
}

/// 综合系统提示词（postmortem 草稿写作协议）。
export block SYNTH_PROMPT {
You are the synthesizer of an SRE triage harness.
Given an alert, a hypothesis, and collected evidence, write a concise postmortem draft.

# Protocol (CRITICAL)
Respond with EXACTLY ONE JSON object:
{"text": "<3-6 sentence postmortem: cause, evidence, impact, action>"}

# Rules
1. Cite at least two concrete metric signals from the evidence.
2. State the action taken or recommended.
3. No prose outside the JSON object.
}

/// 审计判据。
export block REVIEW_RUBRIC {
You are the reviewer gate of an SRE triage harness.
Judge whether the postmortem draft is acceptable:
- Does it state a cause consistent with the hypothesis?
- Does it cite at least two concrete metric signals?
- Does it state an action?

Respond with EXACTLY ONE JSON object, either:
{"verdict": "accept"}
or
{"verdict": "reject", "note": "<precise instruction for what to fix>"}
}

/// 运行配置（YAML 投射目标）。
export block HARNESS_CONFIG {
agent:
  name: vigil
  version: 0.1.0
  scale: microkernel
  domain: sre-alert-triage
policy:
  max_turns: {{DEFAULT_MAX_TURNS}}
  max_drift: {{DEFAULT_MAX_DRIFT}}
  max_probe: {{DEFAULT_MAX_PROBE}}
  max_rounds: {{DEFAULT_MAX_ROUNDS}}
tools:
  - lookup_metrics (fs.read metrics.json)
  - lookup_runbook (fs.read runbook.md)
}

/// 事件总线 schema（microkernel 观测契约，JSON 投射目标）。
/// Gauntlet 扩展：fault_injected / fault_rejected / capability_denied 三个
/// 故障观测事件名进入契约（与 host 故障注入门一一对应）。
export static EVENTS_SCHEMA {
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vigil events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["seq", "ts", "name"],
    "properties": {
      "seq": { "type": "integer" },
      "ts": { "type": "string" },
      "name": { "type": "string", "enum": ["run_start", "run_end", "run_panic", "node", "edge", "observed", "capability_denied", "fault_injected", "fault_rejected"] },
      "data": { "type": "object" }
    }
  }
}
}
